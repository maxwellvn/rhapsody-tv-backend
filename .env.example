# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=https://your-frontend-domain.com
DISCORD_WEBHOOK_URL=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rhapsody-tv

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# ImageKit (optional if you don't upload media from backend)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ZeptoMail (required if email verification is enabled)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=

# KingsChat OAuth Profile Validation
KINGSCHAT_PROFILE_URL=https://connect.kingsch.at/api/profile
KINGSCHAT_CLIENT_ID=com.kingschat
KINGSCHAT_CLIENT_VERSION=web-2.0
KINGSCHAT_DEVICE_ID=web
KINGSCHAT_PLATFORM=web
KINGSCHAT_REQUEST_TIMEOUT_MS=10000

# Stripe (test keys for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
